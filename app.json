{
  "expo": {
    "name": "Growie",
    "slug": "hack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logotyp.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photos",
        "NSPhotoLibraryAddUsageDescription": "Allow $(PRODUCT_NAME) to save photos",
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to use your camera",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use your microphone"
      },
      "bundleIdentifier": "com.anonymous.hack"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/kotek.png",
        "backgroundColor": "#006600"
      },
      "package": "com.anonymous.hack"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@reactvision/react-viro",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logotyp.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-font",
        {
          "MaterialIcons": "./node_modules/react-native-vector-icons/Fonts/MaterialIcons.ttf"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
